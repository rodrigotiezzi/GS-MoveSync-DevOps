flowchart TB
    subgraph USUARIOS["Usuários"]
        OP["Operador / Admin<br/>(prefeitura, CET)"]
        IOT["Sensores e câmeras IoT<br/>(dados simulados)"]
    end

    subgraph DEVOPS["Azure DevOps — projeto MoveSync"]
        BOARDS["Azure Boards<br/>Epic → Feature → User Story → Task"]
        REPOS["Azure Repos (Git)<br/>main protegida: PR + revisor + work item"]
        CI["Pipeline CI (azure-pipeline.yml)<br/>Maven build · JUnit/Mockito · JaCoCo<br/>artefato .war"]
        CD["Pipeline Release (CD)<br/>Deploy War → App Service<br/>gatilho: novo artefato"]
        BOARDS -. "vincula commits,<br/>branches e PRs" .- REPOS
        REPOS -- "merge na main" --> CI
        CI -- "artefato drop" --> CD
    end

    subgraph AZURE["Microsoft Azure — rg-movesync (criado por scripts/infra-azure.sh)"]
        subgraph PLAN["App Service Plan B1 Linux · East US 2"]
