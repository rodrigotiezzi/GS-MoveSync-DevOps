        end
        subgraph SQLSRV["Azure SQL Server · Central US"]
            DB[("movesyncdb<br/>6 tabelas")]
        end
        WEB -- "JDBC (TLS) · variáveis de ambiente" --> DB
    end

    DEV["Equipe de desenvolvimento"] -- "git push / PR" --> REPOS
    CD -- "deploy" --> WEB
    OP -- "HTTPS /web" --> WEB
