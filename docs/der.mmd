    TB_CRUZAMENTO ||--o{ TB_SEMAFORO : "possui"
    TB_SEMAFORO ||--o{ TB_SEMAFORO_DISPOSITIVO : "é monitorado por"
    TB_DISPOSITIVO ||--o{ TB_SEMAFORO_DISPOSITIVO : "monitora"
    TB_SEMAFORO ||--o{ TB_LEITURA_TRAFEGO : "recebe"
    TB_DISPOSITIVO ||--o{ TB_LEITURA_TRAFEGO : "envia"
    TB_SEMAFORO ||--o{ TB_AJUSTE_TEMPO : "tem histórico"

    TB_CRUZAMENTO {
        BIGINT ID_CRUZAMENTO PK
        VARCHAR NOME
        VARCHAR ENDERECO
        VARCHAR BAIRRO
        FLOAT LATITUDE
        FLOAT LONGITUDE
    }
    TB_SEMAFORO {
        BIGINT ID_SEMAFORO PK
        VARCHAR CODIGO UK
        VARCHAR TIPO
        VARCHAR STATUS
        INT TEMPO_VERDE
        INT TEMPO_AMARELO
        INT TEMPO_VERMELHO
        BIGINT ID_CRUZAMENTO FK
    }
    TB_DISPOSITIVO {
        BIGINT ID_DISPOSITIVO PK
        VARCHAR CODIGO UK
        VARCHAR TIPO
        VARCHAR MODELO
        BIT FL_ONLINE
    }
    TB_SEMAFORO_DISPOSITIVO {
        BIGINT ID_SEMAFORO PK, FK
        BIGINT ID_DISPOSITIVO PK, FK
    }
    TB_LEITURA_TRAFEGO {
        BIGINT ID_LEITURA PK
        BIGINT ID_SEMAFORO FK
        BIGINT ID_DISPOSITIVO FK
        DATETIME2 DT_HORA_LEITURA
        INT QTD_VEICULOS
        INT QTD_PEDESTRES
        FLOAT VELOCIDADE_MEDIA
    }
    TB_AJUSTE_TEMPO {
        BIGINT ID_AJUSTE PK
        BIGINT ID_SEMAFORO FK
        DATETIME2 DT_HORA_AJUSTE
        INT TEMPO_VERDE_ANTERIOR
        INT TEMPO_VERDE_NOVO
        FLOAT MEDIA_VEICULOS
        VARCHAR MOTIVO
    }
