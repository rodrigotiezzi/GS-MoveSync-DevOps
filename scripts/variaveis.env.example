# Copie para variaveis.env, preencha e rode:  source scripts/variaveis.env && bash scripts/infra-azure.sh
# NUNCA versione o arquivo com os valores reais (o .gitignore já bloqueia *.env).

export RM="562975"                      # RM do representante: deixa os nomes globais únicos
export SQL_ADMIN_PASSWORD="troque-por-uma-senha-forte"
export ADMIN_PASSWORD="troque-a-senha-do-admin"
export OPERADOR_PASSWORD="troque-a-senha-do-operador"
# Opcional: se não definir, o script gera um segredo aleatório
# export JWT_SECRET="no-minimo-32-caracteres-aleatorios"
